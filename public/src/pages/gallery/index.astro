---
export const prerender = false;
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { supabase } from '../../lib/supabase';

interface DbPhoto {
  id: string;
  url: string;
  storage_path: string;
  alt: string;
  caption: string;
  round: number | null;
  grade: string | null;
  season: number;
  display_order: number;
  published: boolean;
  created_at: string;
}

// ── Supabase fetch — published photos only ────────────────────────────────────
const { data: dbPhotos } = await supabase
  .from('gallery')
  .select('id, url, alt, caption, round, grade, season, display_order, created_at')
  .eq('published', true)
  .order('display_order', { ascending: true })
  .order('created_at', { ascending: false });
const photos = (dbPhotos ?? []) as DbPhoto[];

// ── Rounds + opponents from the fixtures table ────────────────────────────────
// One opponent per round — all Wallaroo grades play the same club per round.
const { data: fxRounds } = await supabase
  .from('fixtures')
  .select('round, season, opponent')
  .not('round', 'is', null)
  .order('season', { ascending: false });
const roundSeason: number = (fxRounds ?? [])[0]?.season ?? 2026;

const opponentByRound = new Map<number, string>();
for (const f of (fxRounds ?? [])) {
  if (f.season !== roundSeason || f.round == null) continue;
  if (!opponentByRound.has(f.round) && f.opponent) opponentByRound.set(f.round, f.opponent);
}
// Include every round that has a fixture row for the season (byes have
// opponent=null but still exist as scheduled rounds).
const allRoundNums = [...new Set((fxRounds ?? [])
  .filter((f: any) => f.season === roundSeason && f.round != null)
  .map((f: any) => f.round as number))].sort((a, b) => a - b);
const roundNums = allRoundNums.length ? allRoundNums : Array.from({ length: 18 }, (_, i) => i + 1);
const season = roundSeason;
---
<PageLayout
  title="Gallery · Wallaroo FC"
  description="Match-day photos from the YPFL 2026 season — Wallaroo Bulldogs on the boundary, in the contest, and lifting the trophy."
>
  <PageHero
    eyebrow="From the boundary"
    title="Bulldogs"
    titleItalic="in the moment."
    intro="Every round of the season. Download the full set of photos from any round. Got a great shot? Send yours in — the committee will publish the best."
  />

  <section class="contribute-strip">
    <div class="container contribute-inner">
      <div class="contrib-body">
        <div class="contrib-eyebrow">Photographers · parents · supporters</div>
        <h3>Got match photos? Send them straight to the club.</h3>
        <p>Approved contributors upload directly from any device — SD card to gallery in minutes. Every image is reviewed by the committee before it goes public.</p>
      </div>
      <a href="/photos/upload" class="btn-contribute">Upload photos →</a>
    </div>
  </section>

  <section class="gallery-page">
    <div class="container">
      <div class="filters">
        <div class="filter-group">
          <span class="filter-label">Round</span>
          <div class="filter-pills" data-filter-group="round">
            <button class="filter-pill active" data-filter-value="All">All</button>
            {roundNums.map(n => (
              <button class="filter-pill" data-filter-value={`R${n}`}>
                R{n}{opponentByRound.get(n) ? ` v ${opponentByRound.get(n)}` : ' Bye'}
              </button>
            ))}
          </div>
        </div>
        <a id="download-round" class="download-btn" data-season={season} download style="display:none"></a>
      </div>

      {photos.length > 0 ? (
        <div class="photo-grid">
          {photos.map(p => (
            <figure
              class="photo"
              data-round={p.round != null ? `R${p.round}` : 'All'}
            >
              <img
                src={p.url}
                alt={p.alt}
                loading="lazy"
                decoding="async"
              />
              {(p.caption || p.round) && (
                <figcaption>
                  {p.caption && <span class="caption">{p.caption}</span>}
                  {p.round && (
                    <span class="meta">
                      R{p.round}{opponentByRound.has(p.round) ? ` v ${opponentByRound.get(p.round)}` : ''}
                    </span>
                  )}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <div class="empty-icon">📷</div>
          <h3>Photos coming soon</h3>
          <p>The gallery fills up as the committee publishes photos from each round. Match photographers can send theirs in through <a href="/photos/upload">Upload photos</a>.</p>
        </div>
      )}

      <div class="cta">
        <p>More photos uploaded weekly. Got a great shot? Email it to <a href="mailto:admin@wallaroofc.com.au?subject=Gallery%20photo">admin@wallaroofc.com.au</a> or tag <strong>#BulldogsForever</strong>.</p>
      </div>
    </div>
  </section>

  <script>
    // Round filter + per-round bulk download. Vanilla JS, no framework.
    const photoEls = document.querySelectorAll<HTMLElement>('.photo');
    const downloadBtn = document.getElementById('download-round') as HTMLAnchorElement | null;
    const dlSeason = downloadBtn?.dataset.season ?? '2026';

    function applyRound(round: string) {
      photoEls.forEach(p => {
        p.style.display = (round === 'All' || p.dataset.round === round) ? '' : 'none';
      });
      if (downloadBtn) {
        if (round === 'All') {
          downloadBtn.style.display = 'none';
        } else {
          const n = round.replace(/^R/, '');
          downloadBtn.href = `/api/gallery/download?round=${n}&season=${dlSeason}`;
          downloadBtn.textContent = `⬇ Download all — Round ${n}`;
          downloadBtn.style.display = '';
        }
      }
    }

    document.querySelectorAll<HTMLButtonElement>('.filter-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const value = btn.dataset.filterValue;
        if (!value) return;
        btn.parentElement?.querySelectorAll('.filter-pill').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyRound(value);
      });
    });
  </script>
</PageLayout>

<style>
  /* ── Contribute strip ─────────────────────────────────────────────── */
  .contribute-strip {
    background: var(--blue-darkest);
    color: var(--white);
    padding: 40px 32px;
    border-bottom: 3px solid var(--red);
  }
  .contribute-inner {
    max-width: 1400px; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between;
    gap: 32px; flex-wrap: wrap;
  }
  .contrib-body { flex: 1; min-width: 260px; }
  .contrib-eyebrow {
    font-family: var(--headline); font-size: 12px; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--red); margin-bottom: 8px;
  }
  .contribute-strip h3 {
    font-family: var(--display); font-size: clamp(24px, 3vw, 34px);
    letter-spacing: 0.02em; text-transform: uppercase;
    color: var(--white); margin: 0 0 8px;
  }
  .contribute-strip p {
    font-family: var(--serif); font-size: 15px; line-height: 1.55;
    color: rgba(255,255,255,0.75); margin: 0; max-width: 640px;
  }
  .btn-contribute {
    display: inline-block;
    background: var(--red); color: var(--white);
    font-family: var(--headline); font-size: 13px; letter-spacing: 0.14em;
    text-transform: uppercase; text-decoration: none;
    padding: 14px 26px; border-radius: 6px;
    border: 2px solid var(--red);
    white-space: nowrap;
    transition: background 0.2s, border-color 0.2s;
  }
  .btn-contribute:hover { background: var(--red-deep); border-color: var(--red-deep); }

  .gallery-page { background: var(--cream); padding: 64px 32px 120px; }
  .container { max-width: 1400px; margin: 0 auto; }
  .filters { display: flex; gap: 40px; margin-bottom: 40px; flex-wrap: wrap; align-items: center; }
  .filter-group { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .filter-label { font-family: var(--headline); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey); }
  .filter-pills { display: flex; gap: 6px; flex-wrap: wrap; }
  .filter-pill { background: var(--white); border: 1px solid var(--line); padding: 8px 14px; font-family: var(--headline); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--charcoal); cursor: pointer; border-radius: 2px; transition: all 0.2s; white-space: nowrap; }
  .filter-pill:hover { border-color: var(--red); color: var(--red); }
  .filter-pill.active { background: var(--red); color: var(--white); border-color: var(--red); }
  .download-btn { margin-left: auto; background: var(--red); color: var(--white); border: 1px solid var(--red); padding: 9px 18px; font-family: var(--headline); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; border-radius: 2px; cursor: pointer; text-decoration: none; white-space: nowrap; }
  .download-btn:hover { background: var(--red-deep); border-color: var(--red-deep); }

  .photo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .photo { position: relative; margin: 0; overflow: hidden; border-radius: 4px; background: var(--blue-darkest); aspect-ratio: 4 / 3; }
  .photo img,
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .photo:hover img,
  .photo:hover :global(img) { transform: scale(1.06); }
  .photo figcaption { position: absolute; bottom: 0; left: 0; right: 0; padding: 16px; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 100%); color: var(--white); opacity: 0; transition: opacity 0.3s; }
  .photo:hover figcaption { opacity: 1; }
  .photo .caption { display: block; font-family: var(--display); font-size: 16px; text-transform: uppercase; letter-spacing: 0.02em; margin-bottom: 4px; }
  .photo .meta { font-family: var(--headline); font-size: 11px; letter-spacing: 0.14em; color: rgba(255,255,255,0.7); text-transform: uppercase; }

  .empty-state {
    text-align: center; padding: 96px 24px; background: var(--white);
    border: 1px solid var(--line); border-radius: 6px;
  }
  .empty-icon { font-size: 48px; margin-bottom: 12px; }
  .empty-state h3 {
    font-family: var(--display); font-size: 26px; letter-spacing: 0.02em;
    text-transform: uppercase; color: var(--charcoal); margin: 0 0 8px;
  }
  .empty-state p {
    font-family: var(--serif); font-size: 16px; color: var(--grey);
    max-width: 480px; margin: 0 auto;
  }
  .empty-state a { color: var(--red); border-bottom: 2px solid var(--red); padding-bottom: 1px; }

  .cta { margin-top: 56px; text-align: center; font-family: var(--serif); font-size: 17px; color: var(--grey); }
  .cta a { color: var(--red); border-bottom: 2px solid var(--red); padding-bottom: 1px; }

  @media (max-width: 900px) { .photo-grid { grid-template-columns: repeat(2, 1fr); } .gallery-page { padding: 48px 24px; } }
  @media (max-width: 500px) { .photo-grid { grid-template-columns: 1fr; } }
</style>
