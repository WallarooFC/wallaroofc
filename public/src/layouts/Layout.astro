---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = 'Wallaroo Football Club — Home of the Bulldogs',
  description = "Founded 1867. One of Australia's oldest continuously running football clubs. YPFL · SANFL Affiliate. Wallaroo Oval, Cornish Terrace, SA.",
  canonical,
  ogImage = '/og-default.jpg',
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? 'https://wallaroofc.com').toString();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="Wallaroo Football Club" />
  <meta property="og:locale" content="en_AU" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fonts — non-blocking load: print media + onload swap. font-display:swap in URL gives FOUT not FOIT. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
    href="https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Oswald:wght@400;600&family=Fraunces:ital,wght@0,600;1,400&family=Inter:wght@400;600&display=swap"
  />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Oswald:wght@400;600&family=Fraunces:ital,wght@0,600;1,400&family=Inter:wght@400;600&display=swap" />
  </noscript>

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <slot />

  <script>
    // Masthead shadow on scroll
    const masthead = document.getElementById('masthead');
    if (masthead) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 12) masthead.classList.add('scrolled');
        else masthead.classList.remove('scrolled');
      }, { passive: true });
    }

    // Reveal-on-scroll observer
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // Ladder tabs
    document.querySelectorAll<HTMLButtonElement>('.ladder-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const grade = tab.dataset.grade;
        if (!grade) return;
        const card = tab.closest('.ladder-card');
        if (!card) return;
        card.querySelectorAll('.ladder-tab').forEach(t => t.classList.remove('active'));
        card.querySelectorAll('.ladder-panel').forEach(p => p.classList.remove('active'));
        tab.classList.add('active');
        card.querySelector(`.ladder-panel[data-panel="${grade}"]`)?.classList.add('active');
      });
    });
  </script>

  <!-- Landing takeover popup — fetches the active announcement and shows it as
       a centred modal for ~10s on every visit. Managed from /admin/takeovers. -->
  <script is:inline>
    (function () {
      "use strict";
      var API_URL = "/api/takeover/current";
      var HOLD_MS = 10000;
      var ANIM_MS = 500;
      var ROOT_ID = "wfc-takeover-root";
      var STYLE_ID = "wfc-takeover-styles";

      function injectStylesOnce() {
        if (document.getElementById(STYLE_ID)) return;
        var css =
          "#" + ROOT_ID + "{position:fixed;inset:0;z-index:2147483000;display:flex;align-items:center;justify-content:center;pointer-events:none;font-family:Inter,system-ui,-apple-system,'Segoe UI',sans-serif;}" +
          "#" + ROOT_ID + " .wfc-backdrop{position:absolute;inset:0;background:rgba(5,14,31,0.66);opacity:0;transition:opacity " + ANIM_MS + "ms ease-out;pointer-events:auto;}" +
          "#" + ROOT_ID + ".wfc-in .wfc-backdrop{opacity:1;}" +
          "#" + ROOT_ID + " .wfc-card{position:relative;max-width:520px;width:calc(100% - 32px);background:linear-gradient(160deg,#0A1F3D 0%,#050E1F 100%);border:1px solid rgba(200,16,46,0.35);border-radius:14px;box-shadow:0 24px 64px rgba(5,14,31,0.6);overflow:hidden;transform:translateY(-40px) scale(0.96);opacity:0;transition:transform " + ANIM_MS + "ms cubic-bezier(0.16,1,0.3,1),opacity " + ANIM_MS + "ms ease-out;pointer-events:auto;}" +
          "#" + ROOT_ID + ".wfc-in .wfc-card{transform:translateY(0) scale(1);opacity:1;}" +
          "#" + ROOT_ID + " .wfc-card-image{max-width:460px;background:transparent;border:none;box-shadow:none;overflow:visible;}" +
          "#" + ROOT_ID + " .wfc-img{display:block;width:100%;height:auto;max-height:86vh;object-fit:contain;border-radius:12px;box-shadow:0 24px 64px rgba(5,14,31,0.5);}" +
          "#" + ROOT_ID + " .wfc-strip{height:4px;background:#C8102E;}" +
          "#" + ROOT_ID + " .wfc-close{position:absolute;top:10px;right:10px;width:32px;height:32px;border:none;background:transparent;color:rgba(255,255,255,0.6);font-size:22px;line-height:1;cursor:pointer;}" +
          "#" + ROOT_ID + " .wfc-close:hover{color:#fff;}" +
          "#" + ROOT_ID + " .wfc-card-image .wfc-close{background:rgba(5,14,31,0.6);color:#fff;border-radius:9999px;z-index:1;}" +
          "#" + ROOT_ID + " .wfc-card-image .wfc-close:hover{background:rgba(5,14,31,0.85);color:#fff;}" +
          "#" + ROOT_ID + " .wfc-body{padding:34px 34px 30px;text-align:center;color:#F0F4F8;}" +
          "#" + ROOT_ID + " .wfc-heading{font-family:'Anton',Impact,sans-serif;font-size:30px;letter-spacing:0.02em;text-transform:uppercase;color:#fff;margin:0 0 14px;line-height:1.08;}" +
          "#" + ROOT_ID + " .wfc-text{font-size:16px;line-height:1.6;margin:0 auto;max-width:42ch;color:rgba(255,255,255,0.85);}" +
          "#" + ROOT_ID + " .wfc-cta{display:inline-block;margin-top:22px;background:#C8102E;color:#fff;text-decoration:none;padding:12px 24px;border-radius:8px;font-weight:600;font-size:14px;letter-spacing:0.02em;}" +
          "#" + ROOT_ID + " .wfc-cta:hover{background:#8E0B20;}" +
          "#" + ROOT_ID + " .wfc-card-flyer{max-width:440px;background:linear-gradient(165deg,#0A1F3D 0%,#050E1F 58%,#0A0F1F 100%);border:1px solid rgba(255,255,255,0.08);border-left:5px solid #C8102E;}" +
          "#" + ROOT_ID + " .wfc-flyer{padding:30px 30px 24px;color:#F0F4F8;text-align:left;}" +
          "#" + ROOT_ID + " .wfc-fly-eyebrow{font-family:'Bebas Neue','Arial Narrow',sans-serif;font-size:13px;letter-spacing:0.22em;color:#C8102E;text-transform:uppercase;margin:0 0 10px;display:flex;align-items:center;gap:10px;}" +
          "#" + ROOT_ID + " .wfc-fly-eyebrow:before{content:'';width:26px;height:2px;background:#C8102E;}" +
          "#" + ROOT_ID + " .wfc-fly-title{font-family:'Anton',Impact,sans-serif;font-weight:400;line-height:0.9;text-transform:uppercase;margin:0 0 12px;}" +
          "#" + ROOT_ID + " .wfc-fly-title .t1{display:block;font-size:52px;color:#fff;}" +
          "#" + ROOT_ID + " .wfc-fly-title .t2{display:block;font-size:52px;color:#C8102E;}" +
          "#" + ROOT_ID + " .wfc-fly-sub{font-family:'Fraunces',Georgia,serif;font-style:italic;font-size:17px;color:rgba(255,255,255,0.72);margin:0 0 16px;}" +
          "#" + ROOT_ID + " .wfc-fly-time{display:inline-flex;align-items:baseline;gap:8px;background:#C8102E;color:#fff;padding:9px 16px;border-radius:3px;margin-bottom:22px;}" +
          "#" + ROOT_ID + " .wfc-fly-time .lbl{font-family:'Bebas Neue','Arial Narrow',sans-serif;letter-spacing:0.14em;font-size:14px;}" +
          "#" + ROOT_ID + " .wfc-fly-time .val{font-family:'Anton',Impact,sans-serif;font-size:26px;line-height:1;}" +
          "#" + ROOT_ID + " .wfc-fly-time .suf{font-family:'Bebas Neue','Arial Narrow',sans-serif;font-size:14px;letter-spacing:0.1em;}" +
          "#" + ROOT_ID + " .wfc-fly-mhead{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:2px;gap:12px;}" +
          "#" + ROOT_ID + " .wfc-fly-mhead .mh{font-family:'Bebas Neue','Arial Narrow',sans-serif;letter-spacing:0.2em;color:#C8102E;font-size:15px;text-transform:uppercase;}" +
          "#" + ROOT_ID + " .wfc-fly-mhead .mn{font-family:'Fraunces',Georgia,serif;font-style:italic;font-size:12px;color:rgba(255,255,255,0.55);text-align:right;}" +
          "#" + ROOT_ID + " .wfc-fly-menu{list-style:none;margin:0 0 16px;padding:12px 0 0;border-top:1px solid rgba(255,255,255,0.14);}" +
          "#" + ROOT_ID + " .wfc-fly-menu li{display:flex;align-items:baseline;gap:8px;margin:0 0 13px;}" +
          "#" + ROOT_ID + " .wfc-fly-menu .n{font-family:Inter,system-ui,sans-serif;font-weight:600;font-size:15px;color:#fff;text-transform:uppercase;letter-spacing:0.01em;}" +
          "#" + ROOT_ID + " .wfc-fly-menu .lead{flex:1;border-bottom:1px dotted rgba(255,255,255,0.3);transform:translateY(-4px);}" +
          "#" + ROOT_ID + " .wfc-fly-menu .p{font-family:'Anton',Impact,sans-serif;font-size:22px;color:#C8102E;white-space:nowrap;}" +
          "#" + ROOT_ID + " .wfc-fly-plus{border-left:3px solid #C8102E;background:rgba(200,16,46,0.09);padding:8px 12px;font-size:14px;margin-bottom:18px;border-radius:0 4px 4px 0;}" +
          "#" + ROOT_ID + " .wfc-fly-plus b{color:#C8102E;margin-right:4px;}" +
          "#" + ROOT_ID + " .wfc-fly-plus i{font-family:'Fraunces',Georgia,serif;color:rgba(255,255,255,0.82);}" +
          "#" + ROOT_ID + " .wfc-fly-foot{display:flex;justify-content:space-between;align-items:flex-end;border-top:1px solid rgba(255,255,255,0.14);padding-top:14px;gap:12px;}" +
          "#" + ROOT_ID + " .wfc-fly-foot .fl b{display:block;font-family:'Bebas Neue','Arial Narrow',sans-serif;letter-spacing:0.05em;font-size:17px;color:#fff;}" +
          "#" + ROOT_ID + " .wfc-fly-foot .fl i{font-family:'Fraunces',Georgia,serif;font-style:italic;font-size:11px;color:rgba(255,255,255,0.5);}" +
          "#" + ROOT_ID + " .wfc-fly-foot .fr{text-align:right;flex-shrink:0;}" +
          "#" + ROOT_ID + " .wfc-fly-foot .fr span{display:block;font-family:'Bebas Neue','Arial Narrow',sans-serif;letter-spacing:0.14em;font-size:10px;color:rgba(255,255,255,0.4);}" +
          "#" + ROOT_ID + " .wfc-fly-foot .fr b{font-family:'Bebas Neue','Arial Narrow',sans-serif;letter-spacing:0.05em;font-size:14px;color:#fff;}" +
          "@media(max-width:460px){#" + ROOT_ID + " .wfc-fly-title .t1,#" + ROOT_ID + " .wfc-fly-title .t2{font-size:42px;}#" + ROOT_ID + " .wfc-flyer{padding:24px 22px 20px;}}" +
          "@keyframes wfc-rock{0%{transform:rotate(calc(var(--wfc-rock-angle,45deg)*-1));}50%{transform:rotate(var(--wfc-rock-angle,45deg));}100%{transform:rotate(calc(var(--wfc-rock-angle,45deg)*-1));}}" +
          "@keyframes wfc-glow{0%,100%{box-shadow:0 20px 60px rgba(5,14,31,0.6);}50%{box-shadow:0 0 46px rgba(46,110,255,0.6),0 0 84px rgba(200,16,46,0.55),0 20px 60px rgba(5,14,31,0.6);}}" +
          "#" + ROOT_ID + " .wfc-spin{animation:wfc-rock 12s ease-in-out infinite;transform-origin:center;}" +
          "#" + ROOT_ID + " .wfc-glam{animation:wfc-glow 2.6s ease-in-out infinite;}" +
          "#" + ROOT_ID + " .wfc-spin.wfc-glam{animation:wfc-rock 12s ease-in-out infinite,wfc-glow 2.6s ease-in-out infinite;}" +
          "@keyframes wfc-drift{0%{transform:translate(0,0);}20%{transform:translate(7vw,-6vh);}40%{transform:translate(-6vw,5vh);}60%{transform:translate(6vw,7vh);}80%{transform:translate(-7vw,-5vh);}100%{transform:translate(0,0);}}" +
          "#" + ROOT_ID + " .wfc-float{animation:wfc-drift 18s ease-in-out infinite;}" +
          "@media(prefers-reduced-motion:reduce){#" + ROOT_ID + " .wfc-spin{animation:none;}#" + ROOT_ID + " .wfc-spin.wfc-glam{animation:wfc-glow 2.6s ease-in-out infinite;}#" + ROOT_ID + " .wfc-float{animation:none;}}";
        var s = document.createElement("style");
        s.id = STYLE_ID;
        s.textContent = css;
        document.head.appendChild(s);
      }

      function esc(str) {
        return String(str == null ? "" : str)
          .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;").replace(/'/g, "&#039;");
      }

      // Structured "flyer" layout — mirrors the club meal-flyer design so a
      // takeover looks like the printed flyer but stays fully data-driven.
      function flyerHtml(d) {
        var menu = Array.isArray(d.menu) ? d.menu : [];
        var rows = menu.map(function (m) {
          return '<li><span class="n">' + esc(m.n || m.item || "") + '</span>' +
                 '<span class="lead"></span>' +
                 '<span class="p">' + esc(m.p || m.price || "") + '</span></li>';
        }).join("");
        var timeHtml = d.timeValue
          ? '<div class="wfc-fly-time"><span class="lbl">' + esc(d.timeFrom || "From") + '</span>' +
            '<span class="val">' + esc(d.timeValue) + '</span>' +
            (d.timeSuffix ? '<span class="suf">' + esc(d.timeSuffix) + '</span>' : "") + '</div>'
          : "";
        var plusHtml = d.plusNote
          ? '<div class="wfc-fly-plus"><b>' + esc(d.plusLabel || "Plus") + '</b> <i>' + esc(d.plusNote) + '</i></div>'
          : "";
        var noteHtml = d.menuNote ? '<span class="mn">' + esc(d.menuNote) + '</span>' : "";
        return '<div class="wfc-flyer">' +
          '<div class="wfc-fly-eyebrow">' + esc(d.eyebrow || "This week after training") + '</div>' +
          '<h2 class="wfc-fly-title"><span class="t1">' + esc(d.titleTop || "") + '</span>' +
            '<span class="t2">' + esc(d.titleBottom || "") + '</span></h2>' +
          (d.subtitle ? '<p class="wfc-fly-sub">' + esc(d.subtitle) + '</p>' : "") +
          timeHtml +
          '<div class="wfc-fly-mhead"><span class="mh">' + esc(d.menuHeading || "The Menu") + '</span>' + noteHtml + '</div>' +
          '<ul class="wfc-fly-menu">' + rows + '</ul>' +
          plusHtml +
          '<div class="wfc-fly-foot">' +
            '<div class="fl"><b>' + esc(d.footTitle || "Wallaroo Football Club") + '</b>' +
              '<i>' + esc(d.footTag || "Tradition lives here · Est. 1867") + '</i></div>' +
            '<div class="fr"><span>' + esc(d.footRLabel || "Clubrooms") + '</span>' +
              '<b>' + esc(d.footRValue || "Wallaroo Oval") + '</b></div>' +
          '</div>' +
        '</div>';
      }

      function render(body) {
        if (!body) return;
        injectStylesOnce();
        var prior = document.getElementById(ROOT_ID);
        if (prior) prior.remove();

        var root = document.createElement("div");
        root.id = ROOT_ID;
        root.setAttribute("role", "dialog");
        root.setAttribute("aria-modal", "true");
        root.setAttribute("aria-label", "Wallaroo FC announcement");

        if (body.layout === "flyer") {
          root.innerHTML =
            '<div class="wfc-backdrop"></div>' +
            '<div class="wfc-card wfc-card-flyer">' +
              '<button type="button" class="wfc-close" aria-label="Dismiss">&times;</button>' +
              flyerHtml(body) +
            '</div>';
        } else if (body.imageUrl) {
          var img = '<img class="wfc-img" src="' + esc(body.imageUrl) + '" alt="' + esc(body.heading || "Wallaroo FC") + '"/>';
          var inner = body.ctaUrl
            ? '<a href="' + esc(body.ctaUrl) + '" rel="noopener">' + img + '</a>'
            : img;
          root.innerHTML =
            '<div class="wfc-backdrop"></div>' +
            '<div class="wfc-card wfc-card-image">' +
              '<button type="button" class="wfc-close" aria-label="Dismiss">&times;</button>' +
              inner +
            '</div>';
        } else {
          var cta = (body.ctaLabel && body.ctaUrl)
            ? '<a class="wfc-cta" href="' + esc(body.ctaUrl) + '" rel="noopener">' + esc(body.ctaLabel) + '</a>'
            : "";
          root.innerHTML =
            '<div class="wfc-backdrop"></div>' +
            '<div class="wfc-card">' +
              '<div class="wfc-strip"></div>' +
              '<button type="button" class="wfc-close" aria-label="Dismiss">&times;</button>' +
              '<div class="wfc-body">' +
                '<h2 class="wfc-heading">' + esc(body.heading) + '</h2>' +
                '<p class="wfc-text">' + esc(body.body) + '</p>' + cta +
              '</div>' +
            '</div>';
        }

        // Optional glitz: scale (× the base tile), rock rotation (±45°), glam glow.
        var card = root.querySelector(".wfc-card");
        var scale = (typeof body.scale === "number" && body.scale > 0) ? body.scale : 1;
        if (card && scale !== 1) {
          var base = card.className.indexOf("wfc-card-image") !== -1 ? 460 : 520;
          card.style.maxWidth = Math.round(base * scale) + "px";
        }
        var fxTarget = root.querySelector(".wfc-img") || card;
        if (fxTarget) {
          if (body.rotate) fxTarget.classList.add("wfc-spin");
          if (body.glam) fxTarget.classList.add("wfc-glam");
          // Per-template rock angle. Falls back to 45° via the CSS custom
          // property default in the wfc-rock keyframe.
          if (typeof body.rotateDeg === "number" && body.rotateDeg > 0) {
            fxTarget.style.setProperty("--wfc-rock-angle", body.rotateDeg + "deg");
          }
        }
        // Optional gentle drift around the screen. Applied to the whole card, so
        // it composes with a rocking image inside (which animates separately).
        if (body.float && card) card.classList.add("wfc-float");

        document.body.appendChild(root);

        var exitTimer;
        function dismiss() {
          clearTimeout(exitTimer);
          root.classList.remove("wfc-in");
          setTimeout(function () { if (root.parentNode) root.parentNode.removeChild(root); }, ANIM_MS);
        }
        root.querySelector(".wfc-close").addEventListener("click", dismiss);
        root.querySelector(".wfc-backdrop").addEventListener("click", dismiss);
        requestAnimationFrame(function () { root.classList.add("wfc-in"); });
        // Optional per-template hold override (e.g. slow-rocked takeovers
        // that want two full rotation cycles visible).
        var holdMs = (typeof body.holdMs === "number" && body.holdMs > 0) ? body.holdMs : HOLD_MS;
        exitTimer = setTimeout(dismiss, holdMs + ANIM_MS);
      }

      function boot() {
        // Landing page only — the takeover is a home-page announcement.
        if (location.pathname !== "/") return;
        fetch(API_URL, { cache: "no-store", credentials: "omit" })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (payload) {
            if (payload && payload.takeover && payload.takeover.template) {
              render(payload.takeover.template.body);
            }
          })
          .catch(function () { /* silent — the site keeps working */ });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", boot);
      } else {
        boot();
      }
    })();
  </script>
</body>
</html>
